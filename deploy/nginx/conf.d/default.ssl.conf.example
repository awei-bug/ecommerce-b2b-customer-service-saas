# HTTPS 示例：把证书放到 deploy/certs/fullchain.pem 与 privkey.pem 后
# 复制为自己的站点配置，并通过 NGINX_SITE_CONFIG 选择；不要修改默认站点文件。

# HTTP → HTTPS
server {
    listen 80 default_server;
    server_name _;

    location = /healthz {
        access_log off;
        proxy_pass http://api:5000/health/;
        proxy_set_header Host $host;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    # API 与业务（同 default.conf）
    location /api/ {
        proxy_pass http://api:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    location /health/ {
        proxy_pass http://api:5000/health/;
        proxy_set_header Host $host;
    }

    location ~ ^/(user|menu|roles|role|categorys|attributes|attribute|products|product|orders|order|pay|expresses|freight|permissions|upload_img|cate_grup|dashboard|payments)/ {
        proxy_pass http://api:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    location ~* ^/static/upload/[^/]+/pay_proof(?:/|$) {
        return 404;
    }
    location /static/upload/ {
        alias /var/www/uploads/;
        expires 7d;
        access_log off;
        types {
            image/jpeg jpg jpeg;
            image/png png;
            image/gif gif;
            image/webp webp;
        }
        default_type application/octet-stream;
        add_header X-Content-Type-Options nosniff;
    }

    location /admin/ {
        alias /var/www/admin/;
        try_files $uri $uri/ /admin/index.html;
    }

    location / {
        root /var/www/mall;
        try_files $uri $uri/ /index.html;
    }
}
