# 复制为 deploy/.env.prod 或服务器环境文件（勿提交真实密码）
# cp deploy/.env.prod.example deploy/.env.prod

# develop | product
FLASK_CONFIG=product

# 登录防爆破：账户 5 次或来源地址 20 次失败后锁定 15 分钟
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=20
LOGIN_LOCK_MINUTES=15

# 数据库（Compose 内网主机名是 mysql；本机直连用 127.0.0.1）
MYSQL_USERNAME=shop
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=flask_shop_saas
# 仅本机映射 MySQL 时用（默认 3307，勿对公网）
MYSQL_PUBLISH_PORT=127.0.0.1:3307

# 必须换成长随机串：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

JWT_EXPIRATION_DELTA=86400

# 私有化无官方支付：关 mock 成功；收款靠后台「标记已付款」
PAY_DEFAULT_CHANNEL=mock
ALLOW_MOCK_PAY=0

# 短信：生产务必关开发固定码
SMS_DEV_MODE=0
SMS_DEV_CODE=
# 每个店铺手机号连续验证码尝试达到上限后暂时锁定
SMS_LOGIN_ATTEMPT_LIMIT=5
SMS_LOGIN_LOCK_MINUTES=15
# 同一手机号跨店铺共用冷却；每个来源地址的发送额度跨进程共享
SMS_COOLDOWN=60
SMS_SEND_IP_LIMIT=10
SMS_SEND_IP_WINDOW_SECONDS=60
# 生产短信需接入已实现的 HTTP 网关；公网必须使用 HTTPS
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://sms.example.com/send
# SMS_HTTP_TOKEN=replace-with-a-secret

# 平台开通 API 密钥（Header: X-Platform-Key）
PLATFORM_BOOTSTRAP_KEY=change-me-platform-key
PLATFORM_API_ENABLED=0

# 前端域名（逗号分隔，含协议）。同域反代可留空
# CORS_ORIGINS=https://shop.example.com,https://admin.example.com
CORS_ORIGINS=

# 公网域名（证书与 Nginx 文档用）
DOMAIN=shop.example.com
ADMIN_DOMAIN=admin.example.com

# 宿主机映射端口（Windows 常被占 80，默认 18080）
HTTP_PUBLISH_PORT=18080
HTTPS_PUBLISH_PORT=18443
# 默认仅加载 HTTP 站点；启用 HTTPS 时选择已按证书和域名核验的配置
# NGINX_SITE_CONFIG=./nginx/conf.d/my-ssl.conf

# 备份保留天数
BACKUP_KEEP_DAYS=7
