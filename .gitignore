deploy/certs/*.pem
deploy/certs/*.key
deploy/backups/
**/backups/
*.sql.gz
*.log
*.pid
deploy/compose_*.txt
logs/
.local-growth-stack/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
**/__pycache__/
*.sqlite
*.sqlite3

# 虚拟环境
.venv/
venv/
env/
**/.venv/

# ---- 支付/密钥缓存 ----
.wechat_certs/
