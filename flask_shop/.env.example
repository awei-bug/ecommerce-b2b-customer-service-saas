# 复制为 .env 后修改。不要把真实密钥提交到 git。

FLASK_CONFIG=develop
# develop | sample | product | test

# --- 数据库：二选一 ---
# 1) MySQL（推荐）
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=flask_shop
# 2) 或使用 SQLite（二选一，不要同时强开）
# DATABASE_URL=sqlite:///F:/path/to/instance/ecommerce_shop.db

SECRET_KEY=please-use-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_DELTA=86400
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=20
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:18080

# 支付 / 短信（个人码阶段）
ALLOW_MOCK_PAY=1
PAY_DEFAULT_CHANNEL=mock

# AI 内容平台增长归因回传（可选；仅订单有 campaign_id 时发送 order.paid）
# CONTENT_PLATFORM_CONVERSION_WEBHOOK=http://127.0.0.1:3100/api/integrations/ecommerce/conversions
# CONTENT_PLATFORM_WEBHOOK_TOKEN=local-dev-internal-token
SMS_DEV_MODE=1
SUPPORT_BASELINE_MINUTES=6
SMS_PROVIDER=console

# 多智能体 LLM（Key 推荐放「用户环境变量」OPENROUTER_API_KEY，不要写进仓库）
AGENTS_LLM=1
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_API_KEY=sk-or-v1-xxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Agnes AI（文本 / 图片 / 视频；密钥只放后端环境变量）
# 配置后会优先使用 Agnes，未配置时继续使用上面的 OpenRouter。
# AGNES_API_KEY=
AGNES_ENABLED=1
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-3.0-flash
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

COMPANY_SHORT_NAME=云购商城
DEFAULT_TENANT_SLUG=demo
DEFAULT_TENANT_NAME=云购演示旗舰店

# 生产短信
# SMS_DEV_MODE=0
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://example.com/sms/send
# SMS_HTTP_TOKEN=

# --- 短信 HTTP 网关（联调）---
# SMS_DEV_MODE=0
# SMS_PROVIDER=http
# SMS_HTTP_URL=http://127.0.0.1:19090/send
# SMS_HTTP_TOKEN=dev-sms-token

# 大模型（兼容 OpenRouter / DeepSeek / 通义 等 OpenAI 协议）
# LLM_API_KEY 可映射到 OPENROUTER_API_KEY
# LLM_MODEL=google/gemma-4-31b-it:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENTS_LLM=1
