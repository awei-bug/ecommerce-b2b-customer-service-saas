# 复制为 .env 后按本地环境修改（不要提交真实密码 / 商户密钥）
FLASK_ENV=develop

# 数据库
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=flask_shop_saas

# JWT / 会话（生产环境务必换成足够长的随机串，且不要每次启动变化）
SECRET_KEY=change-me-to-a-long-random-string

# JWT 有效期（秒），默认 24 小时
JWT_EXPIRATION_DELTA=86400

# ---------- 支付 ----------
# 默认渠道：mock（本地）| wechat（已有商户号）
PAY_DEFAULT_CHANNEL=mock
# 是否允许 mock 支付成功；生产务必 0
ALLOW_MOCK_PAY=1

# 微信直连商户（选 wechat 时填写；密钥只放服务器，不要发到聊天/不要提交 git）
# WECHAT_MCH_ID=
# WECHAT_MCH_SERIAL_NO=
# WECHAT_MCH_PRIVATE_KEY_PATH=F:/secrets/wechat/apiclient_key.pem
# WECHAT_APP_ID=
# WECHAT_API_V3_KEY=
# WECHAT_NOTIFY_URL=https://你的域名/pay/wechat/notify/
# WECHAT_PAY_TRADE_TYPE=native
# WECHAT_CERT_DIR=F:/secrets/wechat/certs
# WECHAT_PAYER_OPENID=   # 仅 JSAPI/小程序需要

# ---------- C 端短信登录（骨架）----------
# 开发：1=固定验证码，发送接口可返回 dev_code；生产务必 0 并接短信商
SMS_DEV_MODE=1
SMS_DEV_CODE=123456
SMS_CODE_EXPIRE_MINUTES=10

# ---------- 平台开通密钥（租户开通 API）----------
# 请求头 X-Platform-Key 必须一致；生产务必换成长随机串
PLATFORM_BOOTSTRAP_KEY=dev-platform-key-change-me
